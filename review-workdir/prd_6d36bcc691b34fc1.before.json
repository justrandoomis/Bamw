 "gameplayPillars": [
  {
   "title": "Turf War ink battles",
   "description": "Two teams compete to cover the most territory with their ink while controlling movement, routes, and fights.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/store/software/switch/70070000016793/ca1c9fed48b7d2906855956a53f6fe3eba6d868f4d5a22a2376e5740111f01a6"
  },
  {
   "title": "Anarchy Battles",
   "description": "Ranked objective modes add competitive rules such as Splat Zones, Tower Control, Rainmaker, and Clam Blitz.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/store/software/switch/70070000016793/e67088f57a0775b090824fb7fa38b5dc450dfca24fbadf237081c1a5783abe38"
  },
  {
   "title": "Salmon Run co-op",
   "description": "Teams fight waves of Salmonids and bosses while collecting Golden Eggs under shifting hazards.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/store/software/switch/70070000016793/0acb7055768b4b910439bf79d4b9baf50a0aafe0d97db389fe3b1c5508faab54"
  },
  {
   "title": "Story campaign",
   "description": "Return of the Mammalians offers solo stages built around movement, weapons, and puzzle-shooter challenges.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/store/software/switch/70070000016793/9c325e78365434f55d314bf87d60bd8f33a191aeb1f0eee6aa20773bbce7904a"
  },
  {
   "title": "Expansion Pass: Side Order",
   "description": "Wave 2 adds a replayable single-player tower-climbing structure with palettes, upgrades, and escalating challenges.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/store/software/switch/70070000016793/209b5fe1ef2d3eb422b1b0a268f953254706e116e87022cb234834e704d2c092"
  }
 ],
 "worldSummary": "The bundle combines Splatoon 3 with the Expansion Pass, including Inkopolis content and the Side Order single-player roguelite campaign. Splatsville becomes the hub for battles, shops, customization, and competitive progression. Turf War, Anarchy, Salmon Run, events, and gear systems provide the long-term multiplayer loop.",
 "storyChapters": [
  {
   "title": "Arrive in the Splatlands",
   "body": "Splatsville becomes the hub for battles, shops, customization, and competitive progression.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/store/software/switch/70070000016793/e67088f57a0775b090824fb7fa38b5dc450dfca24fbadf237081c1a5783abe38"
  },
  {
   "title": "Investigate Alterna",
   "body": "The base story campaign sends Agent 3 through challenge stages to uncover the truth behind a strange new threat.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/store/software/switch/70070000016793/0acb7055768b4b910439bf79d4b9baf50a0aafe0d97db389fe3b1c5508faab54"
  },
  {
   "title": "Return to Inkopolis",
   "body": "Expansion Pass Wave 1 adds Inkopolis Plaza as an alternate hub.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/store/software/switch/70070000016793/9c325e78365434f55d314bf87d60bd8f33a191aeb1f0eee6aa20773bbce7904a"
  },
  {
   "title": "Enter the Spire of Order",
   "body": "Side Order follows Agent 8 and Pearl in a transformed world with repeated tower ascents and upgrades.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/store/software/switch/70070000016793/209b5fe1ef2d3eb422b1b0a268f953254706e116e87022cb234834e704d2c092"
  },
  {
   "title": "Keep competing after the story",
   "body": "Turf War, Anarchy, Salmon Run, events, and gear systems provide the long-term multiplayer loop.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/store/software/switch/70070000016793/ca1c9fed48b7d2906855956a53f6fe3eba6d868f4d5a22a2376e5740111f01a6"
  }
 ],
