 "faq": [
  {
   "q": "What does this bundle include?",
   "a": "The Splatoon 3 base game plus the Expansion Pass, including Inkopolis and Side Order content."
  },
  {
   "q": "Is online play important?",
   "a": "Yes. Most competitive and cooperative multiplayer modes require Nintendo Switch Online."
  },
  {
   "q": "Can it be played offline?",
   "a": "Yes. The story campaign and Side Order can be played as single-player content, while the major competitive modes are online-focused."
  },
  {
   "q": "Does it support Switch 2?",
   "a": "It is a Nintendo Switch game and Nintendo lists compatibility with Nintendo Switch 2."
  },
  {
   "q": "Why are there four store variants?",
   "a": "The supplied store pricing separates offline/online access and standard/premium Expansion Pass-aware packages."
  }
