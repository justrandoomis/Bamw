 "faq": [
  {
   "q": "Does Pikmin 1+2 include both games?",
   "a": "Yes. The bundle contains Pikmin 1 and Pikmin 2 as Nintendo Switch versions."
  },
  {
   "q": "Is it Pikmin 3 or Pikmin 4 content?",
   "a": "No. This bundle specifically covers the first two Pikmin games."
  },
  {
   "q": "Is the game multiplayer?",
   "a": "The main campaigns are primarily single-player experiences; this import does not market the bundle as an online multiplayer product."
  },
  {
   "q": "Does it work on Nintendo Switch 2?",
   "a": "Yes, as compatible Nintendo Switch software rather than a separate native Switch 2 edition."
  },
  {
   "q": "Which game is more relaxed?",
   "a": "Pikmin 2 is less constrained by the strict day limit that defines Pikmin 1 and focuses more on treasure and caves."
  }
 ],
