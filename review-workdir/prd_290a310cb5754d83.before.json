 "gameplayPillars": [
  {
   "title": "Command tiny Pikmin squads",
   "description": "Grow and direct color-coded Pikmin, each with distinct strengths and environmental resistances.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/ncom/My%20Nintendo%20Store/EN-US/Nintendo%20Switch%20Software/pikmin-1-2-118697/118696-118697-pikmin-1-and-2-ss-1-1280x720"
  },
  {
   "title": "Explore compact alien environments",
   "description": "Search strange natural environments for ship parts, treasure, enemies, and hidden routes.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/ncom/My%20Nintendo%20Store/EN-US/Nintendo%20Switch%20Software/pikmin-1-2-118697/118696-118697-pikmin-1-and-2-ss-2-1280x720"
  },
  {
   "title": "Pikmin 1 time-pressure campaign",
   "description": "Olimar has a limited number of days to recover enough ship parts to escape the planet.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/ncom/My%20Nintendo%20Store/EN-US/Nintendo%20Switch%20Software/pikmin-1-2-118697/118696-118697-pikmin-1-and-2-ss-3-1280x720"
  },
  {
   "title": "Pikmin 2 treasure and cave focus",
   "description": "The sequel removes the original strict countdown and emphasizes caves, treasure collection, and two-captain management.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/ncom/My%20Nintendo%20Store/EN-US/Nintendo%20Switch%20Software/pikmin-1-2-118697/118696-118697-pikmin-1-and-2-ss-4-1280x720"
  },
  {
   "title": "Classic strategy in short sessions",
   "description": "The games combine real-time positioning, light puzzles, resource management, and charming exploration.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/ncom/My%20Nintendo%20Store/EN-US/Nintendo%20Switch%20Software/pikmin-1-2-118697/118696-118697-pikmin-1-and-2-ss-5-1280x720"
  }
 ],
 "worldSummary": "Pikmin 1+2 revisits the foundations of the series: miniature explorers in oversized natural environments where every object, creature, and hazard becomes a strategic puzzle.",
 "storyChapters": [
  {
   "title": "Olimar crash-lands",
   "body": "Captain Olimar crashes on an unknown planet and discovers the Pikmin while trying to rebuild his ship.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/ncom/My%20Nintendo%20Store/EN-US/Nintendo%20Switch%20Software/pikmin-1-2-118697/118696-118697-pikmin-1-and-2-ss-1-1280x720"
  },
  {
   "title": "Recover the Dolphin",
   "body": "Pikmin 1 revolves around locating enough scattered ship parts before Olimar runs out of life support.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/ncom/My%20Nintendo%20Store/EN-US/Nintendo%20Switch%20Software/pikmin-1-2-118697/118696-118697-pikmin-1-and-2-ss-2-1280x720"
  },
  {
   "title": "Return to the planet",
   "body": "Pikmin 2 sends Olimar back with Louie after valuable objects are discovered on the planet.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/ncom/My%20Nintendo%20Store/EN-US/Nintendo%20Switch%20Software/pikmin-1-2-118697/118696-118697-pikmin-1-and-2-ss-3-1280x720"
  },
  {
   "title": "Explore caves and collect treasure",
   "body": "The sequel introduces deep caves, bosses, and treasure-hunting objectives that expand the original formula.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/ncom/My%20Nintendo%20Store/EN-US/Nintendo%20Switch%20Software/pikmin-1-2-118697/118696-118697-pikmin-1-and-2-ss-4-1280x720"
  },
  {
   "title": "Master both adventures",
   "body": "Together the two games establish the key creatures, tactics, and exploration ideas that define the Pikmin series.",
   "imageUrl": "https://assets.nintendo.com/image/upload/ar_16%3A9%2Cb_auto%3Aborder%2Cc_lpad/b_white/f_auto/q_auto/dpr_1.5/ncom/My%20Nintendo%20Store/EN-US/Nintendo%20Switch%20Software/pikmin-1-2-118697/118696-118697-pikmin-1-and-2-ss-5-1280x720"
  }
 ],
