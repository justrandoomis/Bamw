TELEGRAM_ADMIN_CHAT_ID=
# The admin group that receives orders, wallet top-ups and support requests.
# Until this is set, notifications keep going to TELEGRAM_ADMIN_CHAT_ID as
# they do today — the routing falls back rather than going quiet.
# A group id is negative, e.g. -1001234567890.
TELEGRAM_ADMIN_GROUP_ID=
# Forum topic ids inside that group. Positive integers. Leave any of them
# blank and that kind goes to the group with a text prefix instead, which is
# what a group without Forum Topics enabled needs.
TELEGRAM_ORDERS_TOPIC_ID=
TELEGRAM_WALLET_TOPIC_ID=
TELEGRAM_SUPPORT_TOPIC_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=
TELEGRAM_WEBHOOK_SECRET=
